Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"parameterValues", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Lambda]", "->", "0.01"}], ",", 
       RowBox[{"wm", "->", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Cambiamos", " ", "el", " ", "factor", " ", "de", " ", "escala"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"N", "=", 
     RowBox[{
      RowBox[{"log", 
       RowBox[{"(", "a", ")"}]}], "=", 
      RowBox[{"log", 
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"1", "-", "z"}], ")"}]}], ")"}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"solucion", " ", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", "\n", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            SuperscriptBox["x", "\[Prime]",
             MultilineFunction->None], "[", "Z", "]"}], "\[Equal]", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Log", "[", "10", "]"}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "3"}], " ", 
                 RowBox[{"x", "[", "Z", "]"}]}], "+", 
                RowBox[{
                 FractionBox[
                  SqrtBox["6"], "2"], " ", "\[Lambda]", " ", 
                 SuperscriptBox[
                  RowBox[{"y", "[", "Z", "]"}], "2"]}], "+", 
                RowBox[{
                 FractionBox["3", "2"], " ", 
                 RowBox[{"x", "[", "Z", "]"}], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", "wm"}], ")"}], " ", 
                    SuperscriptBox[
                    RowBox[{"x", "[", "Z", "]"}], "2"]}], "+", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "+", "wm"}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    SuperscriptBox[
                    RowBox[{"y", "[", "Z", "]"}], "2"]}], ")"}]}]}], 
                  ")"}]}]}], ")"}]}], ")"}]}]}], "/.", " ", 
          "parameterValues"}], ",", "\n", 
         RowBox[{
          RowBox[{
           RowBox[{
            SuperscriptBox["y", "\[Prime]",
             MultilineFunction->None], "[", "Z", "]"}], "\[Equal]", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Log", "[", "10", "]"}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", 
                  FractionBox[
                   SqrtBox["6"], "2"]}], " ", "\[Lambda]", " ", 
                 RowBox[{"x", " ", "[", "Z", "]"}], 
                 RowBox[{"y", "[", "Z", "]"}]}], "+", 
                RowBox[{
                 FractionBox["3", "2"], " ", 
                 RowBox[{"y", "[", "Z", "]"}], 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", "wm"}], ")"}], " ", 
                    SuperscriptBox[
                    RowBox[{"x", "[", "Z", "]"}], "2"]}], "+", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "+", "wm"}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    SuperscriptBox[
                    RowBox[{"y", "[", "Z", "]"}], "2"]}], ")"}]}]}], 
                  ")"}]}]}], ")"}]}], ")"}]}]}], "/.", " ", 
          "parameterValues"}], ",", "\n", 
         RowBox[{
          RowBox[{"x", "[", "1", "]"}], "==", "0.03"}], ",", 
         RowBox[{
          RowBox[{"y", "[", "1", "]"}], "==", "0.046"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Z", ",", "1", ",", 
         RowBox[{"-", "2"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"x", "[", "1", "]"}], " ", "e", " ", 
     RowBox[{"y", "[", "1", "]"}], " ", "es", " ", "debido", " ", "a", " ", 
     "que", " ", "queremos", " ", "trabajar", " ", "en", " ", "la", " ", 
     "epoca", " ", "de", " ", "materia"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"x", "[", "0", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"y", "[", "0", "]"}], "2"]}], ",", 
       RowBox[{"1", "-", 
        SuperscriptBox[
         RowBox[{"x", "[", "0", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"y", "[", "0", "]"}], "2"]}]}], "}"}], "/.", " ", 
     "solucion"}], "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Gr\[AAcute]fico", " ", "de", " ", "la", " ", "trayectoria", " ", "en", 
     " ", "el", " ", "plano", " ", "xy"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trayectoria", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x", "[", "Z", "]"}], ",", 
           RowBox[{"y", "[", "Z", "]"}]}], "}"}], "/.", " ", "solucion"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"Z", ",", "1", ",", 
         RowBox[{"-", "2"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", "->", "\"\<Trayectoria desde (0, 0) hasta (0, 1)\>\""}]}],
       "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Mostrar", " ", "la", " ", "gr\[AAcute]fica"}], "*)"}], 
   "\[IndentingNewLine]", "trayectoria", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Densidad", " ", "fraccionaria", " ", "para", " ", "la", " ", "energia", 
     " ", "oscura", " ", "y", " ", "para", " ", "la", " ", "materia"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{"x", "[", "Z", "]"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"y", "[", "Z", "]"}], "2"]}], ",", 
         RowBox[{"1", "-", 
          SuperscriptBox[
           RowBox[{"x", "[", "Z", "]"}], "2"], "-", 
          SuperscriptBox[
           RowBox[{"y", "[", "Z", "]"}], "2"]}]}], "}"}], "/.", " ", 
       "solucion"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"Z", ",", 
       RowBox[{"-", "2"}], ",", "1"}], "}"}], ",", " ", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", " ", "Orange"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Energ\[IAcute]a oscura\>\"", ",", "\"\<Materia\>\""}], 
       "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Z\>\"", ",", "\"\<Fracci\[OAcute]n\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Evoluci\[OAcute]n de Energ\[IAcute]a Oscura y Materia\>\""}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Log(1+z)\>\"", ",", 
        "\"\<Fracci\[OAcute]n de Energ\[IAcute]a\>\""}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "Large"}]}], " ", "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{
            SuperscriptBox[
             RowBox[{"x", "[", "Z", "]"}], "2"], "-", 
            SuperscriptBox[
             RowBox[{"y", "[", "Z", "]"}], "2"]}], 
           RowBox[{
            SuperscriptBox[
             RowBox[{"x", "[", "Z", "]"}], "2"], "+", 
            SuperscriptBox[
             RowBox[{"y", "[", "Z", "]"}], "2"]}]], ",", " ", 
          RowBox[{"wm", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "wm"}], ")"}], "*", 
            RowBox[{
             RowBox[{"x", "[", "Z", "]"}], "^", "2"}]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "wm"}], ")"}], "*", 
            RowBox[{
             RowBox[{"y", "[", "Z", "]"}], "^", "2"}]}]}]}], "}"}], "/.", " ",
         "solucion"}], "/.", " ", "parameterValues"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"Z", ",", 
       RowBox[{"-", "2"}], ",", "1"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Thick"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Parametro de la ecuaci\[OAcute]n de estado\>\"", ",", 
        "\"\<Parametro de la ecuaci\[OAcute]n efectiva total\>\""}], "}"}]}], 
     ",", " ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Z\>\"", ",", "\"\<Funci\[OAcute]n\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Evoluci\[OAcute]n del parametro de la ecuaci\[OAcute]n de estado \
para la energ\[IAcute]a oscura\>\""}], ",", 
     RowBox[{"ImageSize", "->", "Large"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
