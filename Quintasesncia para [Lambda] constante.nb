Cell[BoxData[{
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"x", "[", "t_", "]"}], ":=", 
    FractionBox[
     RowBox[{"\[Kappa]", " ", "\[Times]", 
      RowBox[{
       RowBox[{"\[Phi]", "'"}], "[", "t", "]"}]}], 
     RowBox[{
      SqrtBox["6"], "\[Times]", 
      RowBox[{"H", "[", "t", "]"}]}]]}], ";"}], TraditionalForm], "\n", 
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"y", "[", "t_", "]"}], ":=", 
    FractionBox[
     RowBox[{"\[Kappa]", " ", "\[Times]", 
      SqrtBox[
       RowBox[{"V", "[", 
        RowBox[{"\[Phi]", "[", "t", "]"}], "]"}]]}], 
     RowBox[{
      SqrtBox["3"], " ", "\[Times]", 
      RowBox[{"H", "[", "t", "]"}]}]]}], ";"}], TraditionalForm], "\n", 
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[Lambda]", "[", "t_", "]"}], ":=", 
    FractionBox[
     RowBox[{"-", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"V", "[", 
         RowBox[{"\[Phi]", "[", "t", "]"}], "]"}], ",", 
        RowBox[{"\[Phi]", "[", "t", "]"}]}], "]"}]}], 
     RowBox[{"\[Kappa]", "\[Times]", 
      RowBox[{"V", "[", 
       RowBox[{"\[Phi]", "[", "t", "]"}], "]"}]}]]}], ";"}], 
  TraditionalForm], "\n", 
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalGamma]", "[", "t_", "]"}], ":=", 
    FractionBox[
     RowBox[{
      RowBox[{"V", "[", 
       RowBox[{"\[Phi]", "[", "t", "]"}], "]"}], "\[Times]", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"V", "[", 
         RowBox[{"\[Phi]", "[", "t", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "t", "]"}], ",", "2"}], "}"}]}], "]"}]}], 
     SuperscriptBox[
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"V", "[", 
         RowBox[{"\[Phi]", "[", "t", "]"}], "]"}], ",", 
        RowBox[{"\[Phi]", "[", "t", "]"}]}], "]"}], "2"]]}], ";"}], 
