          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}], "/", 
          RowBox[{"H", "[", "t", "]"}]}], "/.", "rules"}], " ", "/.", " ", 
        "rules1"}], " ", "//.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "t", "]"}], "->", 
          FractionBox[
           RowBox[{
            SqrtBox["6"], " ", "\[Times]", 
            RowBox[{"H", "[", "t", "]"}], "\[Times]", 
            RowBox[{"xx", "[", "t", "]"}]}], "\[Kappa]"]}], ",", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"V", "[", 
