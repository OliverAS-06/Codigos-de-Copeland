Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Definimos", " ", "los", " ", "par\[AAcute]metros"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"parameterValues", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Lambda]", "->", "2"}], ",", 
       RowBox[{"wm", "->", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Definir", " ", "puntos", " ", "cr\[IAcute]ticos"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"points", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox["\[Lambda]", 
           SqrtBox["6"]], ",", 
          FractionBox[
           SqrtBox[
            RowBox[{"6", "-", 
             SuperscriptBox["\[Lambda]", "2"]}]], 
           SqrtBox["6"]]}], "}"}], "/.", " ", "parameterValues"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{
            SqrtBox[
             FractionBox["3", "2"]], " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", "wm"}], ")"}]}], "\[Lambda]"], ",", 
          FractionBox[
           RowBox[{
            SqrtBox[
             FractionBox["3", "2"]], " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", "wm"}], ")"}]}], "\[Lambda]"]}], "}"}], "/.", 
        " ", "parameterValues"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Gr\[AAcute]fico", " ", "de", " ", "los", " ", "puntos", " ", 
     "cr\[IAcute]ticos"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"criticalPointsPlot", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"points", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"PointSize", "[", "0.03", "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Campo", " ", "vectorial"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vectorField0", "=", "\[IndentingNewLine]", 
     RowBox[{"StreamPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"-", "3"}], " ", "x"}], "+", 
           RowBox[{
            FractionBox[
             SqrtBox["6"], "2"], " ", "\[Lambda]", " ", 
            SuperscriptBox["y", "2"]}], "+", 
           RowBox[{
            FractionBox["3", "2"], " ", "x", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "wm"}], ")"}], " ", 
               SuperscriptBox["x", "2"]}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", "wm"}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 SuperscriptBox["y", "2"]}], ")"}]}]}], ")"}]}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              SqrtBox["6"], "2"]}], " ", "\[Lambda]", " ", "x", " ", "y"}], 
           "+", 
           RowBox[{
            FractionBox["3", "2"], " ", "y", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "wm"}], ")"}], " ", 
               SuperscriptBox["x", "2"]}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", "wm"}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 SuperscriptBox["y", "2"]}], ")"}]}]}], ")"}]}]}]}], "}"}], "/.",
         " ", "parameterValues"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"StreamColorFunction", "->", "None"}], ",", 
       RowBox[{"RegionFunction", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "^", "2"}], "+", 
            RowBox[{"y", "^", "2"}]}], "<", "1"}]}], "]"}]}], ",", 
       RowBox[{"AspectRatio", "->", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<x\>\"", ",", "Large", ",", "Black"}], "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<y\>\"", ",", "Large", ",", "Black"}], "]"}]}], 
         "}"}]}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Bold", ",", "18"}], "]"}]}], ",", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"StringJoin", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<\[Lambda] = \>\"", ",", 
             RowBox[{"ToString", "[", 
              RowBox[{"\[Lambda]", "/.", " ", "parameterValues"}], "]"}]}], 
            "}"}], "]"}], ",", "Large", ",", "Black"}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Combinar", " ", "gr\[AAcute]ficos"}], "*)"}], "\n", 
   RowBox[{"dib", "=", 
    RowBox[{"Show", "[", 
     RowBox[{"vectorField0", ",", "criticalPointsPlot", ",", 
      RowBox[{"ImageSize", "->", "700"}], ",", 
      RowBox[{"ImageResolution", "->", "700"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9466290164870214`*^9, 3.9466290175407963`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"85056eee-4483-4454-b19e-a25ed8bb30cb"],

