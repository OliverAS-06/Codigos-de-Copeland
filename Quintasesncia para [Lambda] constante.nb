          RowBox[{"\[Lambda]2", "\[GreaterEqual]", 
           RowBox[{"36", "+", 
            RowBox[{"12", " ", "wm2"}]}]}]}], ")"}]}], ")"}], "||", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"6", "<", "\[Lambda]2", "<", 
         RowBox[{"36", "+", 
          RowBox[{"12", " ", "wm2"}]}]}], "&&", 
        RowBox[{"wm", ">", 
         FractionBox[
          RowBox[{"12", "+", 
           RowBox[{"12", " ", "wm2"}], "+", 
           RowBox[{"3", " ", "\[Lambda]2"}]}], 
          RowBox[{
           RowBox[{"-", "24"}], "+", 
           RowBox[{"4", " ", "\[Lambda]2"}]}]]}]}], ")"}]}], ")"}]}], 
   ")"}]}]], "Output",
