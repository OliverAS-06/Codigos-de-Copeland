  3.945108534364293*^9}},ExpressionUUID->"d5201421-749b-42bf-853c-\
a56a6292f849"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FieldEq1", "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"H", "[", "t", "]"}], "2"], "==", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[Kappa]", "2"], "3"], "\[Times]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", "\[Times]", "\[Epsilon]", " ", "\[Times]", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "t", "]"}], ")"}], "2"]}], "+", 
       RowBox[{"V", "[", 
        RowBox[{"\[Phi]", "[", "t", "]"}], "]"}], "+", 
       RowBox[{"\[Rho]m", "[", "t", "]"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FieldEq0", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "'"}], "[", "t", "]"}], "==", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["\[Kappa]", "2"], "2"]}], "\[Times]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Epsilon]", " ", "\[Times]", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "t", "]"}], ")"}], "2"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "wm"}], ")"}], "\[Times]", " ", 
        RowBox[{"\[Rho]m", "[", "t", "]"}]}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FieldEq", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Epsilon]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Phi]", "''"}], "[", "t", "]"}], "+", 
        RowBox[{"3", "\[Times]", 
         RowBox[{"H", "[", "t", "]"}], "\[Times]", 
         RowBox[{
          RowBox[{"\[Phi]", "'"}], "[", "t", "]"}]}]}], ")"}]}], "+", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"V", "[", 
        RowBox[{"\[Phi]", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"\[Phi]", "[", "t", "]"}]}], "]"}]}], "==", "0"}]}], 
  ";"}]}], "Input",
