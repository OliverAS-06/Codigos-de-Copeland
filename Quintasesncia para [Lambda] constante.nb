Cell[TextData[StyleBox["Soluci\[OAcute]n Num\[EAcute]rica",
 FontWeight->"Bold"]], "Subsection",
 CellChangeTimes->{{3.9452796601630087`*^9, 3.9452796635770063`*^9}, 
